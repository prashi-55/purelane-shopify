{%- comment -%}
  Purelane Hero
  Visual structure follows the supplied Purelane prototype:
  ticker -> glass navigation -> full viewport hero -> promise rail -> staged products.
  Product imagery/pricing remain Shopify-driven through product pickers.
{%- endcomment -%}

<style>
  /* Hide Dawn's header group on pages containing the Purelane prototype hero.
     The prototype supplies its own navigation + ticker. */
  body:has(.purelane-hero) .shopify-section-group-header-group {
    display: none !important;
  }

  .purelane-hero-wrap,
  .purelane-hero-wrap * {
    box-sizing: border-box;
  }

  .purelane-hero-wrap {
    --pl-ink: #17102b;
    --pl-deep: #ffffff;
    --pl-brand: #6b55b8;
    --pl-brand-lt: #8b79c9;
    --pl-paper: #17102b;
    --pl-paper-2: rgba(23,16,43,.72);
    --pl-paper-3: rgba(23,16,43,.50);
    --pl-accent: #f0a03c;
    --pl-accent-2: #c9761d;
    --pl-surface: #17102b;
    --pl-max: 1180px;
    --pl-ease: cubic-bezier(.2,.7,.2,1);
    position: relative;
    z-index: 1;
    overflow: clip;
    color: var(--pl-ink);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .purelane-hero-wrap a {
    color: inherit;
    text-decoration: none;
  }

  .purelane-hero-wrap button {
    font: inherit;
  }

  /* ---------- TICKER ---------- */

  .purelane-hero-ticker {
    position: relative;
    z-index: 40;
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid rgba(75,58,143,.08);
    border-bottom: 1px solid rgba(75,58,143,.10);
    background: rgba(255,255,255,.78);
    color: rgba(23,16,43,.70);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .1em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .purelane-hero-ticker__track {
    display: inline-flex;
    gap: 40px;
    min-width: max-content;
    padding: 9px 20px;
    animation: purelane-hero-ticker 30s linear infinite;
  }

  .purelane-hero-ticker b {
    color: #6d9b35;
    font-weight: 700;
  }

  @keyframes purelane-hero-ticker {
    from {
      transform: translate3d(0,0,0);
    }

    to {
      transform: translate3d(-50%,0,0);
    }
  }

  /* ---------- NAV ---------- */

  .purelane-hero-nav {
    position: relative;
    top: auto;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 20px 14px 14px;
  }

  .purelane-hero-nav__pill {
    width: min(var(--pl-max), calc(100% - 0px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 14px;
    border: 1px solid rgba(75,58,143,.16);
    border-radius: 999px;
    background:
      linear-gradient(
        158deg,
        rgba(255,255,255,.92),
        rgba(246,249,247,.84) 58%,
        rgba(239,245,242,.72)
      );
    box-shadow:
      0 12px 34px rgba(75,58,143,.10),
      inset 0 1px 0 rgba(255,255,255,.95);
    backdrop-filter: blur(20px) saturate(125%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
  }

  .purelane-hero-nav__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
  }

  .purelane-hero-nav__mark {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    border: 1px solid rgba(75,58,143,.14);
    border-radius: 50%;
    background:
      linear-gradient(
        150deg,
        rgba(255,255,255,.80),
        rgba(235,244,239,.78)
      );
  }

  .purelane-hero-nav__mark svg {
    width: 23px;
    height: 23px;
    color: #6d9b35;
  }

  .purelane-hero-nav__brand-text {
    line-height: 1.05;
  }

  .purelane-hero-nav__brand-name {
    display: block;
    color: var(--pl-ink);
    font-family: Outfit, system-ui, sans-serif;
    font-size: 16.5px;
    font-weight: 800;
    letter-spacing: .02em;
    line-height: 1.06;
    text-transform: uppercase;
  }

  .purelane-hero-nav__brand-sub {
    display: block;
    color: rgba(23,16,43,.48);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: .28em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .purelane-hero-nav__links {
    display: flex;
    gap: 26px;
    margin: 0 auto;
    font-size: 13.5px;
    font-weight: 500;
  }

  .purelane-hero-nav__links a {
    position: relative;
    padding: 6px 0;
    color: rgba(23,16,43,.70);
    transition: color .3s ease;
  }

  .purelane-hero-nav__links a::after {
    position: absolute;
    right: 100%;
    bottom: 0;
    left: 0;
    height: 1.5px;
    background: var(--pl-accent);
    content: "";
    transition: right .35s var(--pl-ease);
  }

  .purelane-hero-nav__links a:hover {
    color: var(--pl-ink);
  }

  .purelane-hero-nav__links a:hover::after {
    right: 0;
  }

  .purelane-hero-nav__tools {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .purelane-hero-nav__icon {
    position: relative;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgba(23,16,43,.70);
    cursor: pointer;
    transition:
      background .3s ease,
      color .3s ease,
      transform .3s ease;
  }

  .purelane-hero-nav__icon:hover {
    background: rgba(75,58,143,.08);
    color: var(--pl-ink);
  }

  .purelane-hero-nav__icon:focus-visible {
    outline: 2px solid var(--pl-accent);
    outline-offset: 3px;
  }

  .purelane-hero-nav__icon svg {
    width: 18px;
    height: 18px;
  }

  .purelane-hero-nav__count {
    position: absolute;
    top: 5px;
    right: 5px;
    min-width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--pl-accent-2);
    color: #fff;
    font-size: 9.5px;
    font-weight: 800;
    line-height: 1;
  }

  /* ---------- HERO ---------- */

  .purelane-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 70px 0 34px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 42% 58% at 77% 48%,
        rgba(194,235,205,.82),
        transparent 72%
      ),
      radial-gradient(
        ellipse 35% 45% at 22% 72%,
        rgba(255,255,255,.96),
        transparent 76%
      ),
      linear-gradient(
        110deg,
        #fbfefa 0%,
        #f3fbf5 43%,
        #e1f5e6 100%
      );
  }

  .purelane-hero::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        102deg,
        rgba(255,255,255,.34) 0%,
        rgba(255,255,255,.12) 38%,
        transparent 68%
      );
    content: "";
    pointer-events: none;
  }

  .purelane-hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse at center,
        transparent 42%,
        rgba(108,156,122,.10) 100%
      );
    content: "";
    pointer-events: none;
  }

  .purelane-hero__grid {
    position: relative;
    z-index: 2;
    width: min(var(--pl-max), calc(100% - 36px));
    min-height: calc(100svh - 160px);
    margin: 0 auto;
  }

  .purelane-hero__copy {
    position: relative;
    z-index: 4;
    width: min(600px, 55%);
    padding-bottom: 8px;
  }

  .purelane-hero__heading {
    margin: 0 0 20px;
    color: var(--pl-ink);
    font-family: Outfit, system-ui, sans-serif;
    font-size: clamp(48px, 8.6vw, 112px);
    font-weight: 800;
    letter-spacing: -.018em;
    line-height: .87;
    text-transform: uppercase;
    text-shadow: none;
  }

  .purelane-hero__heading .purelane-hero__accent {
    color: var(--pl-accent);
  }

  .purelane-hero__rule {
    max-width: 270px;
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 20px;
  }

  .purelane-hero__rule i {
    height: 1px;
    flex: 1;
    background:
      linear-gradient(
        90deg,
        rgba(236,230,247,.44),
        transparent
      );
  }

  .purelane-hero__rule svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    color: var(--pl-accent);
  }

  .purelane-hero__lede {
    max-width: 44ch;
    margin: 0;
    color: rgba(23,16,43,.64);
    font-size: clamp(15px, 1.35vw, 17.5px);
    line-height: 1.6;
  }

  .purelane-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 26px;
  }

  .purelane-hero__button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .13em;
    line-height: 1;
    text-transform: uppercase;
    transition:
      transform .35s var(--pl-ease),
      background .35s var(--pl-ease),
      box-shadow .35s var(--pl-ease);
  }

  .purelane-hero__button svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  .purelane-hero__button--primary {
    background:
      linear-gradient(
        135deg,
        #c47a1e,
        #8aa52d
      );
    color: #08211a;
    box-shadow:
      0 12px 30px rgba(184,112,28,.18),
      inset 0 1px 0 rgba(255,255,255,.55);
  }

  .purelane-hero__button--primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 18px 40px rgba(201,118,29,.44),
      inset 0 1px 0 rgba(255,255,255,.4);
  }

  .purelane-hero__button--ghost {
    border: 1px solid rgba(75,58,143,.18);
    background: rgba(255,255,255,.50);
    color: var(--pl-ink);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .purelane-hero__button--ghost:hover {
    transform: translateY(-2px);
    background: rgba(255,255,255,.72);
  }

  .purelane-hero__button:focus-visible {
    outline: 2px solid var(--pl-accent);
    outline-offset: 4px;
  }

  /* ---------- DESKTOP PROMISE RAIL ---------- */

  .purelane-hero__rail {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 5;
    width: 96px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 8px;
    border: 1px solid rgba(75,58,143,.14);
    border-radius: 20px;
    background:
      linear-gradient(
        158deg,
        rgba(255,255,255,.72),
        rgba(239,247,243,.58)
      );
    box-shadow:
      0 18px 48px rgba(75,58,143,.12),
      inset 0 1px 0 rgba(255,255,255,.90);
    transform: translateY(-50%);
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
  }

  .purelane-hero__rail-item {
    padding: 11px 4px;
    color: rgba(23,16,43,.64);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .11em;
    line-height: 1.34;
    text-align: center;
    text-transform: uppercase;
  }

  .purelane-hero__rail-item + .purelane-hero__rail-item {
    border-top: 1px solid rgba(236,230,247,.14);
  }

  .purelane-hero__rail-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    margin: 0 auto 8px;
    border: 1px solid rgba(236,230,247,.22);
    border-radius: 50%;
    background: rgba(255,255,255,.50);
    color: var(--pl-accent);
  }

  .purelane-hero__rail-icon svg {
    width: 19px;
    height: 19px;
  }

  /* ---------- MOBILE PROMISE STRIP ---------- */

  .purelane-hero__mobile-promises {
    display: none;
    gap: 8px;
    margin-top: 24px;
  }

  .purelane-hero__mobile-promise {
    flex: 1;
    min-width: 0;
    padding: 11px 6px;
    border: 1px solid rgba(75,58,143,.14);
    border-radius: 14px;
    background:
      linear-gradient(
        158deg,
        rgba(255,255,255,.72),
        rgba(239,247,243,.58)
      );
    color: rgba(23,16,43,.64);
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: .10em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .purelane-hero__mobile-promise svg {
    width: 18px;
    height: 18px;
    display: block;
    margin: 0 auto 6px;
    color: var(--pl-accent);
  }

  /* ---------- PRODUCT STAGE ---------- */

  .purelane-hero__product {
    position: absolute;
    right: 2%;
    bottom: 0;
    z-index: 3;
    width: min(54vw, 610px);
    filter: drop-shadow(0 26px 38px rgba(74,64,117,.18));
  }

  .purelane-hero__product-stage {
    position: relative;
    width: 100%;
    height: clamp(430px, 76svh, 700px);
  }

  /*
    The hero now uses ONE real Shopify product.
    No hard-coded SVG product artwork is used here.
  */

  .purelane-hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-right: 2%;
    opacity: 1;
    pointer-events: auto;
  }

  .purelane-hero__slide > a:first-child {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .purelane-hero__shopify-product-image {
    position: relative;
    z-index: 3;

    display: block;

    width: auto;
    height: min(72svh, 590px);

    max-width: 430px;

    object-fit: contain;
    object-position: center bottom;

    filter:
      drop-shadow(
        0 28px 34px rgba(74,64,117,.22)
      );

    transform: translateY(0);

    transition:
      transform .4s var(--pl-ease),
      filter .4s var(--pl-ease);
  }

  .purelane-hero__shopify-product-image:hover {
    transform: translateY(-7px) scale(1.015);

    filter:
      drop-shadow(
        0 35px 40px rgba(74,64,117,.26)
      );
  }

  /* ---------- PRICE CARD ---------- */

  .purelane-hero__price {
    position: absolute;
    left: 0;
    bottom: 2%;
    z-index: 6;
    max-width: 52%;
    padding: 11px 14px 12px;
    border: 1px solid rgba(75,58,143,.14);
    border-radius: 16px;
    background:
      linear-gradient(
        158deg,
        rgba(255,255,255,.72),
        rgba(239,247,243,.58)
      );
    box-shadow:
      0 18px 48px rgba(75,58,143,.12),
      inset 0 1px 0 rgba(255,255,255,.90);
    opacity: 1;
    transform: translateY(0);
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
  }

  .purelane-hero__price-label {
    display: block;
    color: var(--pl-accent);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .purelane-hero__price-value {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 5px;
  }

  .purelane-hero__price-value strong {
    color: var(--pl-ink);
    font-family: Outfit, system-ui, sans-serif;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1;
  }

  .purelane-hero__price-value s {
    color: rgba(23,16,43,.46);
    font-size: 12px;
  }

  .purelane-hero__price-save {
    display: inline-block;
    margin-top: 7px;
    padding: 3px 8px;
    border: 1px solid rgba(240,160,60,.38);
    border-radius: 999px;
    background: rgba(240,160,60,.20);
    color: var(--pl-accent);
    font-size: 8.4px;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  /* ---------- REMOVE OLD SLIDER DOTS ---------- */

  .purelane-hero__dots {
    display: none;
  }

  .purelane-hero__dot {
    display: none;
  }

  /* ---------- RESPONSIVE ---------- */

  @media (max-width: 1200px) {

    .purelane-hero__copy {
      width: min(470px, 55%);
    }

    .purelane-hero__product {
      width: min(44vw, 440px);
      right: 3%;
    }

    .purelane-hero__shopify-product-image {
      max-width: 350px;
      height: min(68svh, 540px);
    }
  }

  @media (max-width: 1023px) {

    .purelane-hero-nav__links {
      display: none;
    }

    .purelane-hero-nav__tools {
      margin-left: auto;
    }
  }

  @media (max-width: 900px) {

    .purelane-hero-nav {
      top: auto;
    }

    .purelane-hero {
      align-items: flex-end;
      padding-top: 54px;
    }

    .purelane-hero::before {
      background:
        linear-gradient(
          180deg,
          rgba(255,255,255,.22) 0%,
          rgba(255,255,255,.08) 34%,
          rgba(226,244,230,.28) 100%
        );
    }

    .purelane-hero__grid {
      min-height: auto;
    }

    .purelane-hero__copy {
      width: 100%;
    }

    .purelane-hero__rail {
      display: none;
    }

    .purelane-hero__mobile-promises {
      display: flex;
    }

    .purelane-hero__product {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(94vw, 500px);
      margin: 20px auto 0;
    }

    .purelane-hero__product-stage {
      height: clamp(300px, 44svh, 430px);
    }

    .purelane-hero__shopify-product-image {
      height: min(42svh, 390px);
      max-width: 300px;
    }

    .purelane-hero__price {
      left: 0;
      bottom: 2%;
    }
  }

  @media (max-width: 600px) {

    .purelane-hero-ticker {
      font-size: 9.5px;
    }

    .purelane-hero-ticker__track {
      gap: 28px;
      padding: 8px 14px;
    }

    .purelane-hero-nav {
      top: auto;
      padding: 8px 10px 8px;
    }

    .purelane-hero-nav__pill {
      gap: 10px;
      padding: 8px 10px;
    }

    .purelane-hero-nav__mark {
      width: 34px;
      height: 34px;
    }

    .purelane-hero-nav__mark svg {
      width: 20px;
      height: 20px;
    }

    .purelane-hero-nav__brand-name {
      font-size: 14.5px;
    }

    .purelane-hero-nav__brand-sub {
      font-size: 7.6px;
      letter-spacing: .20em;
    }

    .purelane-hero-nav__icon.hide-mobile {
      display: none;
    }

    .purelane-hero {
      padding-top: 48px;
      padding-bottom: 24px;
    }

    .purelane-hero__grid {
      width: calc(100% - 28px);
    }

    .purelane-hero__heading {
      font-size: clamp(46px, 15vw, 70px);
    }

    .purelane-hero__actions {
      flex-direction: column;
    }

    .purelane-hero__button {
      width: 100%;
    }

    .purelane-hero__mobile-promises {
      gap: 6px;
    }

    .purelane-hero__mobile-promise {
      padding: 9px 4px;
      font-size: 7.5px;
    }

    .purelane-hero__mobile-promise svg {
      width: 16px;
      height: 16px;
    }

    .purelane-hero__shopify-product-image {
      height: min(38svh, 330px);
      max-width: 270px;
    }

    .purelane-hero__price {
      right: 2%;
      left: auto;
      min-width: 155px;
      max-width: 58%;
      padding: 9px 12px 10px;
      border-radius: 14px;
    }

    .purelane-hero__price-value strong {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {

    .purelane-hero-ticker__track,
    .purelane-hero__button,
    .purelane-hero-nav__icon {
      animation: none !important;
      transition: none !important;
    }

    .purelane-hero__shopify-product-image {
      transition: none !important;
      transform: none !important;
    }
  }
</style>


<div
  class="purelane-hero-wrap"
  id="purelane-hero-{{ section.id }}"
>

  <!-- =====================================================
       NAVIGATION
       ===================================================== -->

  <div class="purelane-hero-nav">

    <div class="purelane-hero-nav__pill">

      <a
        class="purelane-hero-nav__brand"
        href="{{ routes.root_url }}"
        aria-label="Purelane home"
      >

        <span
          class="purelane-hero-nav__mark"
          aria-hidden="true"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>

        </span>

        <span class="purelane-hero-nav__brand-text">

          <span class="purelane-hero-nav__brand-name">
            Purelane
          </span>

          <span class="purelane-hero-nav__brand-sub">
            Clean, simply
          </span>

        </span>

      </a>


      <nav
        class="purelane-hero-nav__links"
        aria-label="Main"
      >

        {% if section.settings.menu != blank %}

          {% for link in section.settings.menu.links limit: 6 %}

            <a href="{{ link.url }}">
              {{ link.title }}
            </a>

          {% endfor %}

        {% else %}

          <a href="{{ routes.root_url }}">
            Home
          </a>

          <a href="#shop">
            Shop
          </a>

          <a href="#bundles">
            Bundles
          </a>

          <a href="#reviews">
            Reviews
          </a>

        {% endif %}

      </nav>


      <div class="purelane-hero-nav__tools">

        <a
          class="purelane-hero-nav__icon hide-mobile"
          href="{{ routes.search_url }}"
          aria-label="Search"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>

        </a>


        <a
          class="purelane-hero-nav__icon hide-mobile"
          href="{{ routes.account_url }}"
          aria-label="Account"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
          >
            <circle cx="12" cy="8" r="3.6"/>
            <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
          </svg>

        </a>


        <a
          class="purelane-hero-nav__icon"
          href="{{ routes.cart_url }}"
          aria-label="Cart, {{ cart.item_count }} items"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
            <circle cx="10" cy="20.5" r="1.1"/>
            <circle cx="17.5" cy="20.5" r="1.1"/>
          </svg>

          <span class="purelane-hero-nav__count">
            {{ cart.item_count }}
          </span>

        </a>

      </div>

    </div>

  </div>


  <!-- =====================================================
       TICKER
       ===================================================== -->

  <div
    class="purelane-hero-ticker"
    aria-hidden="true"
  >

    <div class="purelane-hero-ticker__track">

      <span>
        {{ section.settings.ticker_1 }}
        <b>{{ section.settings.ticker_1_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_2 }}
        <b>{{ section.settings.ticker_2_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_3 }}
        <b>{{ section.settings.ticker_3_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_4 }}
        <b>{{ section.settings.ticker_4_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_1 }}
        <b>{{ section.settings.ticker_1_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_2 }}
        <b>{{ section.settings.ticker_2_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_3 }}
        <b>{{ section.settings.ticker_3_highlight }}</b>
      </span>

      <span>
        {{ section.settings.ticker_4 }}
        <b>{{ section.settings.ticker_4_highlight }}</b>
      </span>

    </div>

  </div>


  <!-- =====================================================
       HERO
       ===================================================== -->

  <section
    class="purelane-hero"
    aria-labelledby="purelane-hero-heading-{{ section.id }}"
  >

    <div class="purelane-hero__grid">


      <!-- =================================================
           PROMISE RAIL
           ================================================= -->

      <aside
        class="purelane-hero__rail"
        aria-label="Product promises"
      >

        <div class="purelane-hero__rail-item">

          <span class="purelane-hero__rail-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>

          </span>

          Plant<br>
          powered

        </div>


        <div class="purelane-hero__rail-item">

          <span class="purelane-hero__rail-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
              <path d="m9 12 2.2 2.2L15.4 10"/>
            </svg>

          </span>

          Safe for<br>
          kids &amp; pets

        </div>


        <div class="purelane-hero__rail-item">

          <span class="purelane-hero__rail-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <circle cx="12" cy="12" r="8.4"/>
              <path d="M6.4 17.6 17.6 6.4"/>
            </svg>

          </span>

          Zero harsh<br>
          chemicals

        </div>

      </aside>


      <!-- =================================================
           COPY
           ================================================= -->

      <div class="purelane-hero__copy">

        <h1
          id="purelane-hero-heading-{{ section.id }}"
          class="purelane-hero__heading"
        >

          {{ section.settings.heading_line_1 | escape }}
          <br>

          {{ section.settings.heading_line_2 | escape }}
          <br>

          <span class="purelane-hero__accent">
            {{ section.settings.heading_line_3 | escape }}
          </span>

        </h1>


        <div
          class="purelane-hero__rule"
          aria-hidden="true"
        >

          <i></i>

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>

          <i></i>

        </div>


        {% if section.settings.description != blank %}

          <p class="purelane-hero__lede">
            {{ section.settings.description }}
          </p>

        {% endif %}


        <div class="purelane-hero__actions">

          {% if section.settings.primary_label != blank %}

            <a
              class="purelane-hero__button purelane-hero__button--primary"
              href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
            >

              {{ section.settings.primary_label | escape }}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>

            </a>

          {% endif %}


          {% if section.settings.secondary_label != blank %}

            <a
              class="purelane-hero__button purelane-hero__button--ghost"
              href="{{ section.settings.secondary_link | default: '#how' }}"
            >
              {{ section.settings.secondary_label | escape }}
            </a>

          {% endif %}

        </div>


        <!-- MOBILE PROMISES -->

        <div
          class="purelane-hero__mobile-promises"
          aria-label="Product promises"
        >

          <div class="purelane-hero__mobile-promise">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
            </svg>

            Plant powered

          </div>


          <div class="purelane-hero__mobile-promise">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
              <path d="m9 12 2.2 2.2L15.4 10"/>
            </svg>

            Kids &amp; pet safe

          </div>


          <div class="purelane-hero__mobile-promise">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <circle cx="12" cy="12" r="8.4"/>
              <path d="M6.4 17.6 17.6 6.4"/>
            </svg>

            Zero harsh chem

          </div>

        </div>

      </div>


      <!-- =================================================
           SHOPIFY PRODUCT
           ================================================= -->

      {%- assign hero_product_1 = section.settings.product -%}

      {%- if hero_product_1 == blank -%}

        {%- assign hero_product_1 = all_products['purelane-plant-based-multi-surface-home-kitchen-cleaner-with-natural-essential-oils-for-everyday-deep-cleaning'] -%}

      {%- endif -%}


      <div
        class="purelane-hero__product"
        aria-label="Featured Purelane product"
      >

        <div class="purelane-hero__product-stage">

          <div class="purelane-hero__slide">

            {% if hero_product_1 != blank %}

              <a
                href="{{ hero_product_1.url }}"
                aria-label="{{ hero_product_1.title | escape }}"
              >

                {% if hero_product_1.featured_image %}

                  {{
                    hero_product_1.featured_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'purelane-hero__shopify-product-image',
                      loading: 'eager',
                      widths: '400,600,800,900',
                      sizes: '(max-width: 600px) 270px, (max-width: 900px) 300px, 430px',
                      alt: hero_product_1.title
                  }}

                {% endif %}

              </a>


              <!-- PRODUCT PRICE -->

              <a
                class="purelane-hero__price"
                href="{{ hero_product_1.url }}"
              >

                <span class="purelane-hero__price-label">
                  {{ section.settings.price_label_1 | escape }}
                </span>


                <span class="purelane-hero__price-value">

                  <strong>
                    {{ hero_product_1.price | money }}
                  </strong>

                  {% if hero_product_1.compare_at_price > hero_product_1.price %}

                    <s>
                      {{ hero_product_1.compare_at_price | money }}
                    </s>

                  {% endif %}

                </span>


                {% if hero_product_1.compare_at_price > hero_product_1.price %}

                  <span class="purelane-hero__price-save">

                    {% assign saving_amount =
                      hero_product_1.compare_at_price
                      | minus: hero_product_1.price
                    %}

                    {% assign saving_percent =
                      saving_amount
                      | times: 100
                      | divided_by: hero_product_1.compare_at_price
                    %}

                    {{ saving_percent }}% OFF

                  </span>

                {% endif %}

              </a>

            {% endif %}

          </div>

        </div>

      </div>

    </div>

  </section>

</div>


