{% liquid
  assign hero_product = section.settings.product
  assign hero_image = hero_product.featured_image
%}

<section
  id="PurelaneHero-{{ section.id }}"
  class="pl-hero"
  aria-labelledby="PurelaneHeroHeading-{{ section.id }}"
>
  <div class="pl-hero__glow" aria-hidden="true"></div>

  <div class="pl-hero__inner">

    <!-- LEFT CONTENT -->
    <div class="pl-hero__content">

      {% if section.settings.eyebrow != blank %}
        <p class="pl-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1
        id="PurelaneHeroHeading-{{ section.id }}"
        class="pl-hero__heading"
      >
        {{ section.settings.heading_line_1 }}
        <br>
        {{ section.settings.heading_line_2 }}
        <br>
        <span>{{ section.settings.heading_accent }}</span>
      </h1>

      <div class="pl-hero__rule" aria-hidden="true">
        <span></span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <span></span>
      </div>

      {% if section.settings.description != blank %}
        <p class="pl-hero__description">
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="pl-hero__actions">

        {% if section.settings.primary_label != blank %}
          <a
            class="pl-btn pl-btn--primary"
            href="{{ section.settings.primary_link | default: '#shop' }}"
          >
            {{ section.settings.primary_label }}

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h13"/>
              <path d="m13 6 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="pl-btn pl-btn--secondary"
            href="{{ section.settings.secondary_link | default: '#how' }}"
          >
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}

      </div>

      <!-- MOBILE TRUST BADGES -->
      <div class="pl-hero__mobile-badges">

        <div class="pl-hero__mobile-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <span>{{ section.settings.badge_1 }}</span>
        </div>

        <div class="pl-hero__mobile-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          <span>{{ section.settings.badge_2 }}</span>
        </div>

        <div class="pl-hero__mobile-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          <span>{{ section.settings.badge_3 }}</span>
        </div>

      </div>

    </div>

    <!-- PRODUCT -->
    <div class="pl-hero__product">

      {% if hero_product != blank %}

        <a
          class="pl-hero__product-card"
          href="{{ hero_product.url }}"
          aria-label="View {{ hero_product.title | escape }}"
        >

          {% if hero_image != blank %}

            <div class="pl-hero__image-wrap">
              {{
                hero_image
                | image_url: width: 900
                | image_tag:
                  loading: 'eager',
                  widths: '400, 600, 800, 900',
                  sizes: '(min-width: 901px) 45vw, 90vw',
                  alt: hero_image.alt | default: hero_product.title
              }}
            </div>

          {% else %}

            <div class="pl-hero__no-image">
              <span>No product image</span>
            </div>

          {% endif %}

          <div class="pl-hero__product-info">

            <div>
              <span class="pl-hero__product-label">
                {{ section.settings.product_label }}
              </span>

              <strong>
                {{ hero_product.title }}
              </strong>
            </div>

            <div class="pl-hero__price">
              {% if hero_product.compare_at_price > hero_product.price %}
                <strong>
                  {{ hero_product.price | money }}
                </strong>
                <s>
                  {{ hero_product.compare_at_price | money }}
                </s>
              {% else %}
                <strong>
                  {{ hero_product.price | money }}
                </strong>
              {% endif %}
            </div>

          </div>

        </a>

      {% else %}

        <div class="pl-hero__product-placeholder">
          <span>Select a product in the Theme Editor</span>
        </div>

      {% endif %}

    </div>

    <!-- DESKTOP TRUST BADGES -->
    <aside
      class="pl-hero__badges"
      aria-label="Purelane product promises"
    >

      <div class="pl-hero__badge">

        <span class="pl-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>

        <span>{{ section.settings.badge_1 }}</span>

      </div>

      <div class="pl-hero__badge">

        <span class="pl-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>

        <span>{{ section.settings.badge_2 }}</span>

      </div>

      <div class="pl-hero__badge">

        <span class="pl-hero__badge-icon">
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>

        <span>{{ section.settings.badge_3 }}</span>

      </div>

    </aside>

  </div>
</section>

<style>
  #PurelaneHero-{{ section.id }} {
    --pl-ink: #17102b;
    --pl-deep: #241a3d;
    --pl-brand: #4b3a8f;
    --pl-brand-light: #6b55b8;
    --pl-paper: #ece6f7;
    --pl-paper-soft: rgba(236, 230, 247, 0.72);
    --pl-accent: #f0a03c;
    --pl-green: #5d8d1c;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(820px, 100svh);
    background:
      radial-gradient(
        circle at 76% 45%,
        rgba(107, 85, 184, 0.32),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        #17102b 0%,
        #241a3d 52%,
        #302052 100%
      );
    color: var(--pl-paper);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at 18% 38%,
        rgba(75, 58, 143, 0.34),
        transparent 42%
      ),
      linear-gradient(
        110deg,
        rgba(23, 16, 43, 0.9),
        rgba(23, 16, 43, 0.2) 60%,
        rgba(75, 58, 143, 0.16)
      );
  }

  #PurelaneHero-{{ section.id }} .pl-hero__inner {
    position: relative;
    width: min(1180px, calc(100% - 36px));
    min-height: min(820px, 100svh);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
    align-items: center;
    gap: 32px;
    padding: 110px 0 70px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__content {
    position: relative;
    z-index: 3;
    max-width: 610px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__eyebrow {
    margin: 0 0 22px;
    color: var(--pl-paper-soft);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__heading {
    margin: 0;
    color: #fff;
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: clamp(58px, 8vw, 112px);
    font-weight: 800;
    line-height: 0.87;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-shadow: 0 12px 45px rgba(0, 0, 0, 0.35);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__heading span {
    color: var(--pl-accent);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__rule {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 270px;
    margin: 24px 0 20px;
    color: var(--pl-accent);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__rule span {
    height: 1px;
    flex: 1;
    background: linear-gradient(
      90deg,
      rgba(236, 230, 247, 0.45),
      transparent
    );
  }

  #PurelaneHero-{{ section.id }} .pl-hero__rule svg {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__description {
    max-width: 44ch;
    margin: 0;
    color: var(--pl-paper-soft);
    font-family: Inter, system-ui, sans-serif;
    font-size: clamp(15px, 1.35vw, 17.5px);
    line-height: 1.65;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 28px;
  }

  #PurelaneHero-{{ section.id }} .pl-btn {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  #PurelaneHero-{{ section.id }} .pl-btn svg {
    width: 15px;
    height: 15px;
  }

  #PurelaneHero-{{ section.id }} .pl-btn--primary {
    color: #111b14;
    background: linear-gradient(
      135deg,
      var(--pl-accent),
      var(--pl-green)
    );
    box-shadow:
      0 12px 30px rgba(240, 160, 60, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  #PurelaneHero-{{ section.id }} .pl-btn--secondary {
    color: #fff;
    border: 1px solid rgba(236, 230, 247, 0.3);
    background: rgba(236, 230, 247, 0.08);
    backdrop-filter: blur(12px);
  }

  #PurelaneHero-{{ section.id }} .pl-btn:hover {
    transform: translateY(-2px);
  }

  #PurelaneHero-{{ section.id }} .pl-btn:focus-visible,
  #PurelaneHero-{{ section.id }} .pl-hero__product-card:focus-visible {
    outline: 2px solid var(--pl-accent);
    outline-offset: 4px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-card {
    position: relative;
    width: min(100%, 520px);
    padding: 22px;
    border: 1px solid rgba(236, 230, 247, 0.18);
    border-radius: 30px;
    background:
      linear-gradient(
        145deg,
        rgba(236, 230, 247, 0.12),
        rgba(75, 58, 143, 0.18)
      );
    box-shadow:
      0 30px 70px rgba(5, 3, 15, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(18px);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 38px 80px rgba(5, 3, 15, 0.52),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__image-wrap {
    min-height: 390px;
    display: grid;
    place-items: center;
    border-radius: 22px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.94);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__image-wrap img {
    width: 100%;
    height: 390px;
    object-fit: contain;
    filter: drop-shadow(0 24px 28px rgba(0, 0, 0, 0.22));
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-info {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 18px;
    padding: 18px 4px 2px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-info > div:first-child {
    min-width: 0;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-label {
    display: block;
    margin-bottom: 5px;
    color: var(--pl-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-info strong {
    display: block;
    color: #fff;
    font-family: Outfit, Inter, system-ui, sans-serif;
    font-size: 18px;
    line-height: 1.15;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__price {
    flex: 0 0 auto;
    text-align: right;
    white-space: nowrap;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__price strong {
    display: inline;
    font-size: 18px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__price s {
    margin-left: 7px;
    color: rgba(236, 230, 247, 0.52);
    font-size: 13px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__product-placeholder,
  #PurelaneHero-{{ section.id }} .pl-hero__no-image {
    min-height: 390px;
    display: grid;
    place-items: center;
    padding: 30px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--pl-paper-soft);
    text-align: center;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__badges {
    position: absolute;
    right: 0;
    top: 50%;
    z-index: 4;
    width: 92px;
    transform: translateY(-50%);
    padding: 10px 7px;
    border: 1px solid rgba(236, 230, 247, 0.16);
    border-radius: 20px;
    background: rgba(36, 26, 61, 0.55);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(18px);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__badge {
    padding: 11px 4px;
    color: var(--pl-paper-soft);
    text-align: center;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__badge + .pl-hero__badge {
    border-top: 1px solid rgba(236, 230, 247, 0.14);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__badge-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto 7px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(236, 230, 247, 0.2);
    border-radius: 50%;
    color: var(--pl-accent);
    background: rgba(236, 230, 247, 0.08);
  }

  #PurelaneHero-{{ section.id }} .pl-hero__badge-icon svg {
    width: 19px;
    height: 19px;
  }

  #PurelaneHero-{{ section.id }} .pl-hero__mobile-badges {
    display: none;
  }

  @media (max-width: 1100px) {
    #PurelaneHero-{{ section.id }} .pl-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    }

    #PurelaneHero-{{ section.id }} .pl-hero__badges {
      display: none;
    }
  }

  @media (max-width: 900px) {
    #PurelaneHero-{{ section.id }} {
      min-height: auto;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__inner {
      min-height: auto;
      width: min(100% - 28px, 680px);
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 90px 0 50px;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__content {
      max-width: none;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__heading {
      font-size: clamp(56px, 17vw, 92px);
    }

    #PurelaneHero-{{ section.id }} .pl-hero__product {
      order: 2;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__product-card {
      width: 100%;
      padding: 14px;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__image-wrap,
    #PurelaneHero-{{ section.id }} .pl-hero__image-wrap img {
      height: min(82vw, 380px);
      min-height: 0;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__mobile-badges {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 7px;
      margin-top: 24px;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__mobile-badge {
      min-height: 74px;
      padding: 10px 5px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      border: 1px solid rgba(236, 230, 247, 0.14);
      border-radius: 14px;
      background: rgba(236, 230, 247, 0.07);
      color: var(--pl-paper-soft);
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-align: center;
      text-transform: uppercase;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__mobile-badge svg {
      width: 19px;
      height: 19px;
      color: var(--pl-accent);
    }
  }

  @media (max-width: 520px) {
    #PurelaneHero-{{ section.id }} .pl-hero__inner {
      width: min(100% - 22px, 480px);
      padding-top: 78px;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__heading {
      font-size: clamp(50px, 17vw, 76px);
    }

    #PurelaneHero-{{ section.id }} .pl-hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    #PurelaneHero-{{ section.id }} .pl-btn {
      width: 100%;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__product-info {
      display: block;
    }

    #PurelaneHero-{{ section.id }} .pl-hero__price {
      margin-top: 10px;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #PurelaneHero-{{ section.id }} *,
    #PurelaneHero-{{ section.id }} *::before,
    #PurelaneHero-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plant-powered homecare"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Hero product"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product label",
      "default": "Purelane essential"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Trust badge 1",
      "default": "Plant powered"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Trust badge 2",
      "default": "Safe for kids & pets"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Trust badge 3",
      "default": "Zero harsh chemicals"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}