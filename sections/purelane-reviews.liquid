<section class="purelane-reviews" id="reviews-{{ section.id }}">
  <div class="purelane-reviews__head">

    {% if section.settings.eyebrow != blank %}
      <span class="pl-kicker">
        {{ section.settings.eyebrow | escape }}
      </span>
    {% endif %}

    <span class="purelane-reviews__aggregate">
      <span class="purelane-reviews__stars">★★★★★</span>
      <strong>{{ section.settings.rating | default: '4.8' | escape }}</strong>
      {{ section.settings.rating_label | default: 'from 8,000+ reviews' | escape }}
    </span>

    <span class="purelane-reviews__aggregate">
      {{ section.settings.homes_label | default: 'Loved by' | escape }}
      <strong>{{ section.settings.homes_value | default: '12 lakh+' | escape }}</strong>
      homes
    </span>

  </div>

  <div class="purelane-reviews__rail" aria-label="Customer reviews">

    <div class="purelane-reviews__track">

      {% for repeat in (1..2) %}
        {% for block in section.blocks %}

          <article
            class="purelane-review pl-glass-2"
            {{ block.shopify_attributes }}
          >

            <div
              class="purelane-review__stars"
              aria-label="{{ block.settings.rating }} out of 5 stars"
            >
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  ★
                {% else %}
                  ☆
                {% endif %}
              {% endfor %}
            </div>

            <h3 class="purelane-review__title">
              {{ block.settings.title | escape }}
            </h3>

            <blockquote class="purelane-review__text">
              “{{ block.settings.review | escape }}”
            </blockquote>

            <div class="purelane-review__who">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                aria-hidden="true"
              >
                <path d="m5 13 4 4L19 7"/>
              </svg>

              <strong>
                {{ block.settings.name | escape }}
              </strong>

              {% if block.settings.product_label != blank %}
                <span>
                  · {{ block.settings.product_label | escape }}
                </span>
              {% endif %}

            </div>

          </article>

        {% endfor %}
      {% endfor %}

    </div>

  </div>
</section>


<style>

#reviews-{{ section.id }} {
  --pl-navy: #211b3d;
  --pl-purple: #28213f;
  --pl-muted: #77758a;
  --pl-green: #719f19;
  --pl-dark-green: #12675f;
  --pl-orange: #d18b21;

  position: relative;

  width: 100%;

  overflow: hidden;

  padding: 72px 0 78px;

  background:
    radial-gradient(
      ellipse at 18% 20%,
      rgba(255,255,255,.78) 0%,
      rgba(255,255,255,0) 42%
    ),
    radial-gradient(
      ellipse at 82% 35%,
      rgba(255,255,255,.45) 0%,
      rgba(255,255,255,0) 38%
    ),
    linear-gradient(
      180deg,
      #edf9f1 0%,
      #dff4e7 42%,
      #c9ead7 100%
    );
}


/* =========================================
   ORGANIC BACKGROUND LINES
   ========================================= */

#reviews-{{ section.id }}::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  opacity: .72;

  background:
    linear-gradient(
      170deg,
      transparent 0%,
      transparent 25%,
      rgba(255,255,255,.42) 25.4%,
      transparent 26%,
      transparent 52%,
      rgba(255,255,255,.36) 52.4%,
      transparent 53%
    );
}


/* =========================================
   HEADER
   ========================================= */

#reviews-{{ section.id }} .purelane-reviews__head {
  position: relative;

  z-index: 2;

  display: flex;

  align-items: center;

  justify-content: center;

  flex-wrap: wrap;

  gap: 12px 22px;

  padding: 0 24px;

  margin: 0 auto 34px;

  text-align: center;

  color: var(--pl-purple);
}


/* THAT'S WHAT THEY SAID */

#reviews-{{ section.id }} .pl-kicker {
  color: #77758a;

  font-size: 12px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: .24em;

  text-transform: uppercase;

  white-space: nowrap;
}


/* AGGREGATE TEXT */

#reviews-{{ section.id }} .purelane-reviews__aggregate {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  color: #59566d;

  font-size: 14px;

  line-height: 1.2;

  font-weight: 700;

  letter-spacing: .035em;
}


#reviews-{{ section.id }} .purelane-reviews__aggregate strong {
  color: var(--pl-purple);

  font-weight: 900;
}


/* GREEN STARS IN HEADER */

#reviews-{{ section.id }} .purelane-reviews__stars {
  color: var(--pl-green);

  font-size: 13px;

  line-height: 1;

  letter-spacing: 2px;
}


/* =========================================
   REVIEW RAIL
   ========================================= */

#reviews-{{ section.id }} .purelane-reviews__rail {
  position: relative;

  z-index: 2;

  width: 100%;

  overflow: hidden;

  padding: 4px 0 12px;
}


#reviews-{{ section.id }} .purelane-reviews__track {
  display: flex;

  width: max-content;

  align-items: stretch;

  gap: 16px;

  padding-left: max(
    24px,
    calc((100vw - 1500px) / 2)
  );

  animation:
    purelane-reviews-scroll-{{ section.id }}
    38s linear infinite;
}


/* =========================================
   REVIEW CARD
   ========================================= */

#reviews-{{ section.id }} .purelane-review {
  position: relative;

  flex: 0 0 305px;

  min-height: 180px;

  display: flex;

  flex-direction: column;

  padding: 20px 20px 18px;

  box-sizing: border-box;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.79),
      rgba(244,251,247,.60)
    );

  border: 1px solid rgba(75,122,103,.17);

  box-shadow:
    0 10px 30px rgba(39,89,67,.07),
    inset 0 1px 0 rgba(255,255,255,.82);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

  color: var(--pl-purple);

  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;
}


/* CARD HOVER */

#reviews-{{ section.id }} .purelane-review:hover {
  transform: translateY(-5px);

  border-color: rgba(55,111,88,.27);

  box-shadow:
    0 18px 40px rgba(39,89,67,.12),
    inset 0 1px 0 rgba(255,255,255,.9);
}


/* =========================================
   CARD STARS
   ========================================= */

#reviews-{{ section.id }} .purelane-review__stars {
  margin-bottom: 12px;

  color: var(--pl-green);

  font-size: 13px;

  line-height: 1;

  font-weight: 900;

  letter-spacing: 3px;
}


/* =========================================
   TITLE
   ========================================= */

#reviews-{{ section.id }} .purelane-review__title {
  margin: 0 0 10px;

  color: var(--pl-purple);

  font-size: 15px;

  line-height: 1.25;

  font-weight: 900;

  letter-spacing: .015em;

  text-transform: uppercase;
}


/* =========================================
   REVIEW TEXT
   ========================================= */

#reviews-{{ section.id }} .purelane-review__text {
  margin: 0;

  padding: 0;

  border: 0;

  color: #5b586e;

  font-size: 13px;

  line-height: 1.55;

  font-weight: 500;

  min-height: 62px;
}


/* =========================================
   CUSTOMER INFORMATION
   ========================================= */

#reviews-{{ section.id }} .purelane-review__who {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 6px;

  margin-top: auto;

  padding-top: 15px;

  color: #77758a;

  font-size: 10.5px;

  line-height: 1.2;

  font-weight: 700;

  letter-spacing: .09em;

  text-transform: uppercase;
}


#reviews-{{ section.id }} .purelane-review__who svg {
  width: 13px;

  height: 13px;

  flex: 0 0 13px;

  color: var(--pl-green);
}


#reviews-{{ section.id }} .purelane-review__who strong {
  color: var(--pl-dark-green);

  font-weight: 900;
}


#reviews-{{ section.id }} .purelane-review__who span {
  color: #77758a;

  font-weight: 700;
}


/* =========================================
   MARQUEE
   ========================================= */

@keyframes purelane-reviews-scroll-{{ section.id }} {

  0% {
    transform: translate3d(0, 0, 0);
  }

  100% {
    transform: translate3d(-50%, 0, 0);
  }

}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

  #reviews-{{ section.id }} {
    padding: 55px 0 60px;
  }

  #reviews-{{ section.id }} .purelane-reviews__head {
    gap: 10px 15px;

    margin-bottom: 27px;

    padding: 0 18px;
  }

  #reviews-{{ section.id }} .pl-kicker {
    width: 100%;

    font-size: 10px;
  }

  #reviews-{{ section.id }} .purelane-reviews__aggregate {
    font-size: 11px;
  }

  #reviews-{{ section.id }} .purelane-review {
    flex-basis: 285px;

    min-height: 180px;
  }

}


/* =========================================
   SMALL MOBILE
   ========================================= */

@media screen and (max-width: 480px) {

  #reviews-{{ section.id }} .purelane-reviews__head {
    padding: 0 14px;
  }

  #reviews-{{ section.id }} .purelane-reviews__aggregate {
    font-size: 10px;
  }

  #reviews-{{ section.id }} .purelane-review {
    flex-basis: 275px;
  }

}


/* =========================================
   REDUCED MOTION
   ========================================= */

@media (prefers-reduced-motion: reduce) {

  #reviews-{{ section.id }} .purelane-reviews__track {
    animation: none;
  }

}

</style>


